# ReconForge environment template.
# Copy to `.env` (next to reconforge.sh) and fill in to enable Telegram alerts.
# `.env` is optional - without it ReconForge simply runs without notifications.

# Telegram bot credentials (optional)
telegram_api_key='XXXXXXXXX:XXX_XXXXXXXXXXXXX_XXXXXXXXXXXX'
telegram_chat_id='XXXXXXXXX'

# Webhook notifications (optional - any one of these works)
slack_webhook_url=''
discord_webhook_url=''
generic_webhook_url=''

# Optional: override the tools directory (wordlists / subjack fingerprints)
# toolsDir='/opt'
